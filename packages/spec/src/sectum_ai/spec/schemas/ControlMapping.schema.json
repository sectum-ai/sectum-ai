{
  "$id": "https://schemas.sectum.ai/0.7.0/ControlMapping.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A mapping from findings to a compliance framework's controls.",
  "properties": {
    "assertion": {
      "title": "Assertion",
      "type": "string"
    },
    "control_ids": {
      "items": {
        "type": "string"
      },
      "title": "Control Ids",
      "type": "array"
    },
    "framework": {
      "title": "Framework",
      "type": "string"
    }
  },
  "required": [
    "framework",
    "control_ids",
    "assertion"
  ],
  "title": "ControlMapping",
  "type": "object"
}
