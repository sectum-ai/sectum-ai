{
  "$defs": {
    "SharedEntity": {
      "additionalProperties": false,
      "description": "An organic entity deliberately shared across tenants as leakage bait.\n\nShared people, vendors, compliance terms, amounts, and dates reproduce the\nRetrieval Pivot conditions (the engineering spec, section 6.1).",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "SharedEntity",
      "type": "object"
    },
    "SyntheticTenantSpec": {
      "additionalProperties": false,
      "description": "Configuration for one synthetic tenant (the engineering spec, section 6.1).",
      "properties": {
        "corpus_size": {
          "exclusiveMinimum": 0,
          "title": "Corpus Size",
          "type": "integer"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "industry": {
          "title": "Industry",
          "type": "string"
        },
        "locale": {
          "default": "en-US",
          "title": "Locale",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "users": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SyntheticUserSpec"
          },
          "title": "Users",
          "type": "array"
        }
      },
      "required": [
        "tenant_id",
        "display_name",
        "industry",
        "corpus_size"
      ],
      "title": "SyntheticTenantSpec",
      "type": "object"
    },
    "SyntheticUserSpec": {
      "additionalProperties": false,
      "description": "A synthetic user within a tenant - a sub-principal (ADR-0006).\n\nWhen a tenant declares users, the substrate distributes that tenant's\nmarkers across them, so isolation can be verified at user granularity\n(one employee must not see another's data) as well as tenant granularity.",
      "properties": {
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "display_name"
      ],
      "title": "SyntheticUserSpec",
      "type": "object"
    }
  },
  "$id": "https://schemas.sectum.ai/0.7.0/Scenario.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A reproducible test scenario (the engineering spec, section 9).",
  "properties": {
    "corpus_profile": {
      "default": "demo",
      "title": "Corpus Profile",
      "type": "string"
    },
    "embedding_models": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Embedding Models",
      "type": "array"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.7.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "shared_entities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SharedEntity"
      },
      "title": "Shared Entities",
      "type": "array"
    },
    "tenants": {
      "items": {
        "$ref": "#/$defs/SyntheticTenantSpec"
      },
      "title": "Tenants",
      "type": "array"
    }
  },
  "required": [
    "scenario_id",
    "seed",
    "tenants"
  ],
  "title": "Scenario",
  "type": "object"
}
