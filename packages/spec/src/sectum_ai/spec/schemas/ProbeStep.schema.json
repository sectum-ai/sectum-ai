{
  "$id": "https://schemas.sectum.ai/0.6.0/ProbeStep.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A single planned probe action issued from one principal's session.\n\n``actor_user_id`` is set when the step is issued from a specific user within\n``actor_tenant_id``'s tenant (ADR-0006); a tenant-level step leaves it\n``None`` and behaves exactly as before.",
  "properties": {
    "action": {
      "title": "Action",
      "type": "string"
    },
    "actor_tenant_id": {
      "format": "uuid",
      "title": "Actor Tenant Id",
      "type": "string"
    },
    "actor_user_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actor User Id"
    },
    "payload": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Payload",
      "type": "object"
    },
    "probe_id": {
      "title": "Probe Id",
      "type": "string"
    },
    "step_id": {
      "title": "Step Id",
      "type": "string"
    }
  },
  "required": [
    "step_id",
    "probe_id",
    "actor_tenant_id",
    "action"
  ],
  "title": "ProbeStep",
  "type": "object"
}
