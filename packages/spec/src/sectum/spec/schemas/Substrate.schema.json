{
  "$defs": {
    "CorpusDocument": {
      "additionalProperties": false,
      "description": "One synthetic document in a tenant's corpus (the engineering spec, section 6.2).",
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "doc_type": {
          "title": "Doc Type",
          "type": "string"
        },
        "marker_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Marker Ids",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metadata",
          "type": "object"
        },
        "owner_user_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner User Id"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "tenant_id",
        "doc_type",
        "title",
        "content"
      ],
      "title": "CorpusDocument",
      "type": "object"
    },
    "GroundTruthManifest": {
      "additionalProperties": false,
      "description": "Authoritative record of which marker belongs to which tenant.\n\nThe manifest is a pure function of the scenario and seed; it carries no\nwall-clock time so the reproducibility contract holds byte-for-byte. Its\ncanonical hash is computed via ``sectum.spec.hashing.canonical_hash``.",
      "properties": {
        "manifest_id": {
          "title": "Manifest Id",
          "type": "string"
        },
        "markers": {
          "items": {
            "$ref": "#/$defs/Marker"
          },
          "title": "Markers",
          "type": "array"
        },
        "scenario_hash": {
          "title": "Scenario Hash",
          "type": "string"
        },
        "schema_version": {
          "default": "0.2.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "manifest_id",
        "scenario_hash",
        "markers"
      ],
      "title": "GroundTruthManifest",
      "type": "object"
    },
    "Marker": {
      "additionalProperties": false,
      "description": "A planted canary whose appearance in the wrong principal proves leakage.\n\n``owner_user_id`` is set only when the marker is owned by a specific user\nwithin ``owner_tenant_id``'s tenant (ADR-0006); a tenant-level marker\nleaves it ``None``.",
      "properties": {
        "embedding_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Ref"
        },
        "marker_id": {
          "title": "Marker Id",
          "type": "string"
        },
        "marker_type": {
          "$ref": "#/$defs/MarkerType"
        },
        "owner_tenant_id": {
          "format": "uuid",
          "title": "Owner Tenant Id",
          "type": "string"
        },
        "owner_user_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner User Id"
        },
        "plaintext": {
          "minLength": 1,
          "title": "Plaintext",
          "type": "string"
        },
        "planted_locations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlantedLocation"
          },
          "title": "Planted Locations",
          "type": "array"
        }
      },
      "required": [
        "marker_id",
        "marker_type",
        "owner_tenant_id",
        "plaintext"
      ],
      "title": "Marker",
      "type": "object"
    },
    "MarkerType": {
      "description": "The three canary marker types (the engineering spec, section 6.3).",
      "enum": [
        "HARD_CANARY",
        "ENTITY_CANARY",
        "SECRET_CANARY"
      ],
      "title": "MarkerType",
      "type": "string"
    },
    "PlantedLocation": {
      "additionalProperties": false,
      "description": "Where a marker was planted within a document.",
      "properties": {
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "field"
      ],
      "title": "PlantedLocation",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "description": "A reproducible test scenario (the engineering spec, section 9).",
      "properties": {
        "corpus_profile": {
          "default": "demo",
          "title": "Corpus Profile",
          "type": "string"
        },
        "embedding_models": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Embedding Models",
          "type": "array"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "default": "0.2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "shared_entities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SharedEntity"
          },
          "title": "Shared Entities",
          "type": "array"
        },
        "tenants": {
          "items": {
            "$ref": "#/$defs/SyntheticTenantSpec"
          },
          "title": "Tenants",
          "type": "array"
        }
      },
      "required": [
        "scenario_id",
        "seed",
        "tenants"
      ],
      "title": "Scenario",
      "type": "object"
    },
    "SharedEntity": {
      "additionalProperties": false,
      "description": "An organic entity deliberately shared across tenants as leakage bait.\n\nShared people, vendors, compliance terms, amounts, and dates reproduce the\nRetrieval Pivot conditions (the engineering spec, section 6.1).",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "SharedEntity",
      "type": "object"
    },
    "SyntheticTenantSpec": {
      "additionalProperties": false,
      "description": "Configuration for one synthetic tenant (the engineering spec, section 6.1).",
      "properties": {
        "corpus_size": {
          "exclusiveMinimum": 0,
          "title": "Corpus Size",
          "type": "integer"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "industry": {
          "title": "Industry",
          "type": "string"
        },
        "locale": {
          "default": "en-US",
          "title": "Locale",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "users": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SyntheticUserSpec"
          },
          "title": "Users",
          "type": "array"
        }
      },
      "required": [
        "tenant_id",
        "display_name",
        "industry",
        "corpus_size"
      ],
      "title": "SyntheticTenantSpec",
      "type": "object"
    },
    "SyntheticUserSpec": {
      "additionalProperties": false,
      "description": "A synthetic user within a tenant - a sub-principal (ADR-0006).\n\nWhen a tenant declares users, the substrate distributes that tenant's\nmarkers across them, so isolation can be verified at user granularity\n(one employee must not see another's data) as well as tenant granularity.",
      "properties": {
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "display_name"
      ],
      "title": "SyntheticUserSpec",
      "type": "object"
    }
  },
  "$id": "https://schemas.sectum.ai/0.2.0/Substrate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The seeded substrate: tenants, corpora, markers, and the manifest.",
  "properties": {
    "documents": {
      "items": {
        "$ref": "#/$defs/CorpusDocument"
      },
      "title": "Documents",
      "type": "array"
    },
    "manifest": {
      "$ref": "#/$defs/GroundTruthManifest"
    },
    "scenario": {
      "$ref": "#/$defs/Scenario"
    },
    "schema_version": {
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenants": {
      "items": {
        "$ref": "#/$defs/SyntheticTenantSpec"
      },
      "title": "Tenants",
      "type": "array"
    }
  },
  "required": [
    "scenario",
    "tenants",
    "documents",
    "manifest"
  ],
  "title": "Substrate",
  "type": "object"
}
