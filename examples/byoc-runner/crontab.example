# Sectum AI — BYOC runner cron for the Snapshot subscription.
#
# Install with: sudo crontab -u sectum /path/to/crontab.example
#
# Environment file holds the bearer secret + customer ID + email.
# Source it from your secret manager into a root-owned 0600 file.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Reads SECTUM_UPLOAD_BEARER, SECTUM_CUSTOMER_ID, SECTUM_CUSTOMER_EMAIL.
BASH_ENV=/etc/sectum/runner.env

# 03:00 on the 1st of every month. Logs go to syslog via `logger`.
0 3 1 * * cd /var/lib/sectum && \
  rm -rf .sectum-ai && \
  sectum seed   --workdir .sectum-ai --config /etc/sectum/sectum.yaml 2>&1 | logger -t sectum-snapshot && \
  sectum probe  --workdir .sectum-ai --config /etc/sectum/sectum.yaml --output json 2>&1 | logger -t sectum-snapshot && \
  sectum report --workdir .sectum-ai --config /etc/sectum/sectum.yaml 2>&1 | logger -t sectum-snapshot && \
  sectum-upload --workdir .sectum-ai \
    --customer-id "$SECTUM_CUSTOMER_ID" \
    --customer-email "$SECTUM_CUSTOMER_EMAIL" \
    --api-url "https://platform.sectum.ai/evidence/upload" 2>&1 | logger -t sectum-snapshot
