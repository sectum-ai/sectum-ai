# Sectum AI — BYOC runner config example
#
# Drop this at /etc/sectum-ai/sectum-ai.yaml and edit the adapter blocks to
# point at your actual stack. Credentials resolve from env vars at
# runtime; the YAML itself never carries plaintext secrets.

scenario:
  # Deterministic seed. Reproducibility is the contract: same seed +
  # same scenario produces a byte-identical ground-truth manifest.
  seed: 2026
  corpus_profile: production

# Where the runner writes the substrate + run + evidence pack. Wipe
# between runs (the wrapper script does this automatically).
workdir: /var/lib/sectum

adapters:
  vector_store:
    kind: pinecone
    api_key_env: PINECONE_API_KEY
    index: production-rag
    # Set to true to model a leaky deploy; false (default) uses one
    # Pinecone namespace per synthetic tenant.
    shared_index: false

  cache:
    kind: redis
    dsn_env: REDIS_DSN
    # tenant_scoped: false (default false) reproduces the
    # GPTCache-style failure where the key is the query hash and not
    # the (tenant, query) tuple.
    tenant_scoped: true

  observability:
    kind: langfuse
    public_key_env: LANGFUSE_PUBLIC_KEY
    secret_key_env: LANGFUSE_SECRET_KEY
    host: https://cloud.langfuse.com

  agent:
    kind: http
    url: https://your-agent.example.com/run
    # If your agent supports a per-call tenant header, name it here so
    # the Class 7 probes can faithfully transmit tenant context.
    tenant_argument: x-tenant-id

  mcp:
    kind: http
    url: https://your-mcp.example.com/sse
    tenant_argument: tenant

  memory:
    kind: fake
    # If you run a persistent memory store (Mem0, custom), swap to its
    # kind. The fake adapter is a useful placeholder when memory is
    # not part of the AI surface.

  model:
    kind: fake
    # The fake model adapter is the right default unless you run a
    # per-tenant fine-tune layer (then swap to the live adapter for
    # your model provider).

  rag:
    kind: http
    url: https://your-rag.example.com/ask
    tenant_argument: tenant_id

# Evidence-chain anchoring. Production runs use a real RFC 3161 TSA
# and (optionally) record the run digest in a Sigstore Rekor
# transparency log.
evidence:
  timestamper: rfc3161
  tsa_url: https://freetsa.org/tsr
  rekor: true
  # rekor_url: https://rekor.sigstore.dev    # default public Rekor

# Detection-pipeline providers. Production calibration uses a real
# embedding model + a calibrated LLM judge; the fake providers are
# only correct for the demo substrate.
detection:
  embedder:
    kind: openai
    model: text-embedding-3-small
    api_key_env: OPENAI_API_KEY

  judge:
    kind: openai
    model: gpt-4o-mini
    api_key_env: OPENAI_API_KEY

  semantic_threshold: 0.62
