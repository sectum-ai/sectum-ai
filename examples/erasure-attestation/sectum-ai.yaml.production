# Production-shape config for the Erasure Attestation engagement.
#
# Originally configured rfc3161 + FreeTSA (https://freetsa.org/tsr)
# but FreeTSA goes down intermittently. Real engagements should pin a
# customer-chosen TSA (their preferred trust anchor); the local-dev
# default is appropriate for the OSS sample so the regeneration is
# reproducible. The Rekor flag shows the production shape; the checked-in
# samples were regenerated WITHOUT it, so they are unanchored
# (`rekor_proof: null`, `anchored_in_log: false`).
#
# A production-shape reference only. The docs/samples/ regeneration recipe
# (docs/samples/README.md) uses sectum-ai.yaml, and so does run.sh: the two
# configs build different substrates, so this one does not reproduce the
# committed samples.

scenario:
  seed: 2026
  corpus_profile: demo
workdir: out

evidence:
  timestamper: local
  rekor: true
  # rekor_url defaults to https://rekor.sigstore.dev
