# examples/open-webui-run/.env.example
#
# Copy to `.env` and fill in. NEVER commit the real `.env` (it is gitignored).
# These are LAB credentials for a self-hosted instance we own - not production
# secrets - but they still must not land in git.
#
#   cp .env.example .env
#   # then edit .env and set the values below

# --- Open WebUI container ---------------------------------------------------
# Pinned image tag under test. Default v0.9.6 (latest stable, post the
# 0.9.0/0.9.5 cross-tenant CVE fixes). Set v0.8.12 to reproduce a pre-fix
# baseline for a before/after demo.
OWUI_IMAGE_TAG=v0.9.6
OLLAMA_IMAGE_TAG=0.6.8

# Host port Open WebUI is published on. The shim + provisioning talk to
# http://localhost:${OWUI_PORT}.
OWUI_PORT=3000
OWUI_BASE_URL=http://localhost:3000

# JWT signing key for Open WebUI. Generate one:
#   openssl rand -hex 32
WEBUI_SECRET_KEY=replace-me-with-openssl-rand-hex-32

# --- Synthetic tenant + admin accounts (provisioned into Open WebUI) --------
# The admin is registered FIRST (Open WebUI makes the first user admin). Then
# the 4 tenant users are registered. All are synthetic lab accounts.
OWUI_ADMIN_EMAIL=admin@sectum.test
OWUI_ADMIN_PASSWORD=replace-me-admin-password

# One shared password for the 4 tenant users keeps the script simple; each user
# still gets its own account + JWT. Override per-user in provision-owui.py if you
# prefer distinct passwords.
OWUI_TENANT_PASSWORD=replace-me-tenant-password

# --- Sectum <-> Open WebUI bridge ------------------------------------------
# Where the provisioning script writes the tenant->user->knowledge map (read by
# the RAG shim). Relative to examples/open-webui-run/.
SECTUM_OWUI_MAP=out/tenant-map.json

# Isolation mode the RAG shim presents to Sectum:
#   isolated  - each tenant's chat attaches ONLY its own Private knowledge base
#               (expected Retrieval-Pivot Rate ~0%: isolation verified)
#   shared    - every tenant's chat attaches the ONE shared knowledge base that
#               holds all tenants' docs (expected RPR high: the realistic
#               shared-collection misconfiguration leak - the Class 2 flagship)
# The operator runs BOTH to produce the before/after contrast.
SECTUM_OWUI_MODE=shared

# Local model the lab uses to compose chat answers (pulled by up.sh). A tiny
# instruct model keeps the run fast; RAG retrieval (the leak surface) does not
# depend on model quality.
OWUI_OLLAMA_MODEL=qwen2.5:0.5b
