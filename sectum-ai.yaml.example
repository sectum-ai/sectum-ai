# Sectum AI configuration template.
#
# Copy to `sectum-ai.yaml` at the project root, edit the blocks you need, and pass
# `--config sectum-ai.yaml` to the CLI:
#
#     uv run sectum-ai seed   --config sectum-ai.yaml
#     uv run sectum-ai probe  --config sectum-ai.yaml
#     uv run sectum-ai report --config sectum-ai.yaml
#
# Anything omitted uses the built-in default; explicit CLI flags
# (--seed, --workdir, --probe) override the values here.
#
# Credentials never appear inline. Adapter blocks reference environment
# variables (for example `dsn_env: SECTUM_PGVECTOR_DSN`) so the adapter
# resolver looks them up at run time.

# -----------------------------------------------------------------------------
# Scenario: drives the deterministic substrate.
# -----------------------------------------------------------------------------
scenario:
  # Substrate RNG seed. Fixed for reproducibility — same seed => same manifest.
  seed: 2026
  # Reserved for profile-driven corpora: the value is accepted but not yet
  # applied. `sectum-ai seed` generates the demo corpus regardless and the
  # substrate always records `corpus_profile: demo`, so changing this string
  # changes neither the scenario hash nor a baseline.
  corpus_profile: demo
  # Documents per tenant. The package default (500) seeds realistically; lower it
  # for a faster run.
  # corpus_size: 500
  # Embedding models the Class 2 rate sweep runs. Prefixes: st:, openai:, cohere:,
  # voyage:, bedrock:, hash-<dim>, and the legacy fake-* names.
  # embedding_models: ["fake-deterministic"]

# Where seed/probe/report write their artifacts (substrate.json, run.json,
# evidence.json, audit-pack.pdf, attestation.intoto.json).
workdir: .sectum-ai

# -----------------------------------------------------------------------------
# Adapters: a `kind` per family. `fake` is the in-memory deterministic adapter
# used by the unit suite; the live `kind`s below talk to real backends.
#
# Every adapter family defaults to `fake` if you omit it; you only need to
# declare the families you've pointed at real infrastructure.
# -----------------------------------------------------------------------------
adapters:

  # app: the application's own resource API, probed through the vector-store
  # contract (it fills the same slot, so configure `app` OR `vector_store`, not
  # both). `kind: fake` is the only kind today; a live HTTP adapter is not
  # implemented and the resolver says so rather than falling back.
  # app:
  #   kind: fake

  vector_store:
    # kind: fake               # in-memory, deterministic (the default)
    # kind: pgvector           # Postgres + pgvector
    #   dsn_env: SECTUM_PGVECTOR_DSN
    #   user_scoped: false     # true isolates by user within a tenant
    #   (shared_index is a `fake`-only knob: a live store's tenancy is its own)
    # kind: chroma             # Chroma server
    #   host: localhost
    #   port: 8000
    # kind: weaviate           # Weaviate (REST + gRPC)
    #   host: localhost
    #   port: 8080
    #   grpc_port: 50051
    # kind: pinecone           # Pinecone (cloud, opt-in)
    #   index: sectum-canaries      # the index name; it must exist with dimension 64
    #   api_key_env: SECTUM_PINECONE_API_KEY
    # kind: qdrant             # Qdrant (self-hosted)
    #   host: localhost
    #   port: 6333
    # kind: milvus             # Milvus (self-hosted; needs etcd + minio)
    #   uri: http://localhost:19530
    # kind: opensearch         # OpenSearch (self-hosted; knn_vector)
    #   host: localhost
    #   port: 9200
    # kind: azure-search       # Azure AI Search (cloud, opt-in)
    #   endpoint: https://<service>.search.windows.net
    #   api_key_env: SECTUM_AZURE_SEARCH_KEY
    kind: fake

  cache:
    # kind: redis              # Redis (key-prefixed, tenant-scoped)
    #   host: localhost
    #   port: 6379
    kind: fake

  observability:
    # kind: phoenix            # Arize Phoenix (per-tenant project)
    #   base_url: http://localhost:6007   # compose.yaml publishes 6006 as 6007
    # kind: langfuse           # Langfuse cloud or self-hosted
    #   host: https://cloud.langfuse.com
    #   public_key_env: LANGFUSE_PUBLIC_KEY
    #   secret_key_env: LANGFUSE_SECRET_KEY
    # kind: langsmith
    #   api_key_env: LANGSMITH_API_KEY
    # kind: otel               # generic OpenTelemetry (OTLP-JSON trace-query endpoint)
    #   base_url: http://localhost:4318   # any Jaeger/Tempo/collector shim that speaks
    #   query_path: /v1/traces/query   # the Sectum OTLP-JSON trace-query contract
    #   tenant_attribute: tenant.id    # resource attribute carrying the tenant.hex
    # kind: helicone           # Helicone request logs (scoped by a custom property)
    #   api_key_env: HELICONE_API_KEY
    #   tenant_property: tenant        # Helicone-Property-* carrying the tenant.hex
    #                                  # NB: read-only — Helicone has no per-tenant
    #                                  # erasure API, so Class 11 reports its surface
    #                                  # as attestable-with-caveat.
    # kind: datadog            # Datadog APM / LLM Observability spans (scoped by a tag)
    #   api_key_env: DD_API_KEY
    #   application_key_env: DD_APP_KEY
    #   tenant_tag: tenant             # span tag carrying the tenant.hex; read-only —
    #                                  # erasure is governed by retention, so Class 11
    #                                  # reports its surface as attestable-with-caveat.
    kind: fake

  rag:
    # kind: http               # generic JSON HTTP RAG pipeline
    #   url: http://localhost:8000/rag
    # kind: langchain          # any LangChain `Runnable` (a composed LCEL chain)
    #   factory: mypkg.rag:build_chain   # REQUIRED: module.path:callable, called with no
    #                          # arguments, returning an object with `invoke(input)`.
    #                          # Requires the optional `rag-langchain` extra:
    #                          # `pip install sectum-ai-adapters[rag-langchain]`.
    kind: fake

  agent:
    # kind: http               # generic JSON HTTP agent endpoint
    #   url: http://localhost:8000/agent
    # kind: langgraph          # a compiled LangGraph StateGraph (per-thread checkpoint)
    #   factory: mypkg.agents:build   # REQUIRED: module.path:callable returning the
    #                          # runtime object this adapter wraps (see docs/configuration.md). Requires the optional `langgraph`
    #                          # extra: `pip install sectum-ai-adapters[langgraph]`.
    # kind: autogen            # an AutoGen AssistantAgent + UserProxyAgent pair
    #                          # (each per-tenant message prefixed with [tenant:<hex>])
    #   factory: mypkg.agents:build   # REQUIRED: module.path:callable returning the
    #                          # runtime object this adapter wraps (see docs/configuration.md). Requires the optional `autogen`
    #                          # extra: `pip install sectum-ai-adapters[autogen]`.
    # kind: crewai             # a CrewAI Crew (agents + tasks) kicked off per tenant
    #                          # (tenant.hex passed in as the `tenant_id` input
    #                          # variable; templated task descriptions interpolate it)
    #   factory: mypkg.agents:build   # REQUIRED: module.path:callable returning the
    #                          # runtime object this adapter wraps (see docs/configuration.md). Requires the optional `crewai`
    #                          # extra: `pip install sectum-ai-adapters[crewai]`.
    # kind: openai-assistants  # an OpenAI Assistant + per-tenant Thread (the API
    #                          # caches Threads server-side; one per tenant.hex)
    #   factory: mypkg.agents:build   # REQUIRED: module.path:callable returning
    #                          # (client, assistant_id) - see docs/configuration.md.
    #                          # Requires the optional `openai-assistants` extra:
    #                          # `pip install sectum-ai-adapters[openai-assistants]`.
    # kind: anthropic-tooluse  # the Anthropic Messages API in native tool-use mode
    #                          # with one conversation history cached per tenant; each
    #                          # per-tenant user message is prefixed with [tenant:<hex>]
    #                          # and the loop runs to `stop_reason: end_turn` per turn.
    #   factory: mypkg.agents:build   # REQUIRED: module.path:callable returning the
    #                          # Anthropic client the adapter wraps - see
    #                          # docs/configuration.md. Requires the optional
    #                          # `anthropic-tooluse` extra:
    #                          # `pip install sectum-ai-adapters[anthropic-tooluse]`.
    kind: fake

  mcp:
    # kind: stdio              # stdio Model Context Protocol server
    #   command: "uvx"                 # the executable alone - it is exec'd as given
    #   args: ["your-mcp-server"]      # its arguments, one list entry each
    # kind: http               # streamable-HTTP MCP server
    #   url: https://mcp.example.com/mcp
    #   tenant_argument: tenant
    kind: fake

  model:
    # kind: huggingface       # a HuggingFace causal LM with per-tenant PEFT
    #                         # LoRA adapters managed on disk under `adapters_dir`.
    #                         # Requires the optional `huggingface` extras:
    #                         # `pip install sectum-ai-adapters[huggingface]`.
    #   base_model_id: TinyLlama/TinyLlama-1.1B-Chat-v1.0
    #   adapters_dir: ./.sectum-ai/lora-adapters
    #   lora_rank: 8
    #   lora_alpha: 16
    #   train_epochs: 1
    #   device_map: auto
    # kind: vllm              # a serving-only vLLM server over its OpenAI-compatible
    #                         # API. Drives Class 5 (KV-cache timing); Class 9 is
    #                         # skipped and a Class 11 erasure leaves the model
    #                         # surface NOT_COVERED (it trains no per-tenant adapter).
    #                         # Requires `pip install sectum-ai-adapters[vllm]`.
    #   base_url: http://localhost:8000/v1
    #   model: meta-llama/Llama-3.1-8B-Instruct
    #   api_key_env: SECTUM_VLLM_API_KEY   # optional; omit if the server is open
    # kind: tgi               # a serving-only HuggingFace Text Generation Inference
    #                         # server (same Class 5 behavior as vllm; one model per
    #                         # endpoint, so no `model` field). Reached via the
    #                         # huggingface_hub client.
    #                         # Requires `pip install sectum-ai-adapters[tgi]`.
    #   base_url: http://localhost:8080
    #   api_key_env: SECTUM_TGI_API_KEY    # optional; omit for an open endpoint
    kind: fake

  memory:
    # kind: redis              # Redis-backed long-term memory (key-prefixed per tenant)
    #   host: localhost
    #   port: 6379
    # kind: mem0               # mem0 (opt-in; needs the `mem0` extra and an embedder)
    kind: fake

  # The three Class 11 erasure surfaces `sectum-ai erasure` additionally scans.
  # Omit a family to leave it on its in-memory fake (recorded as SYNTHETIC).
  search_index:
    # kind: opensearch         # per-tenant index
    #   host: localhost
    #   port: 9200
    kind: fake
  eval_set:
    # kind: langsmith          # LangSmith Datasets (opt-in; `langsmith` extra)
    #   api_key_env: LANGSMITH_API_KEY
    kind: fake
  backup:
    # kind: s3                 # `boto3` extra; per-tenant prefix
    #   bucket: my-bucket
    #   region_name: us-east-1
    # kind: gcs                # `gcs` extra
    #   bucket: my-bucket
    kind: fake

# -----------------------------------------------------------------------------
# Evidence chain (the engineering spec, section 8).
# -----------------------------------------------------------------------------
evidence:
  # `local`   — fast, dev-only local timestamp with no external anchor (the default).
  # `rfc3161` — submit the attested (whole-pack) digest to an RFC 3161 Time-Stamp Authority.
  timestamper: local
  # tsa_url: https://freetsa.org/tsr
  # Sigstore Rekor transparency log (off by default for dev; on for prod).
  rekor: false
  # rekor_url: https://rekor.sigstore.dev

# -----------------------------------------------------------------------------
# Security: optional at-rest encryption for the ground-truth manifest
# (the engineering spec, section 17).
# -----------------------------------------------------------------------------
security:
  # Name of the env var holding a base64-encoded 32-byte AES-256 key.
  # When set, `sectum-ai seed` seals the substrate and its manifest at rest.
  manifest_key_env: null   # set to e.g. "SECTUM_MANIFEST_KEY" to seal at rest

# -----------------------------------------------------------------------------
# Detection: providers driving the semantic/judge steps of the leak detector.
# Fakes are deterministic and used by the unit suite; switch to real providers
# for higher-fidelity detection on real corpora.
# -----------------------------------------------------------------------------
detection:
  embedder:
    # kind: openai
    #   model: text-embedding-3-small
    #   api_key_env: OPENAI_API_KEY
    kind: fake
  judge:
    # kind: openai
    #   model: gpt-4o-mini
    #   api_key_env: OPENAI_API_KEY
    # kind: anthropic
    #   model: claude-3-5-sonnet
    #   api_key_env: ANTHROPIC_API_KEY
    kind: fake
  # Cosine-similarity gate for semantic candidates. The conservative default
  # suits the fake embedder; raise it once a real embedding model is configured.
  semantic_threshold: 0.62
  # `local` ENFORCES the BYOC posture: detection is the only stage that embeds or
  # judges tenant content, and in `local` mode the config fails fast on any
  # embedder or judge that would call a hosted API.
  mode: hosted   # hosted | local
